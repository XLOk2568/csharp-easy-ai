<Window x:Class="XLOKProject.Add_aifuckgame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XLOKProject"
        mc:Ignorable="d"
        Title="Add_aifuckgame" Height="450" Width="800" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Button Content="设置当前窗口为识别区域" VerticalAlignment="Top" Click="Button_Click"/>
        <Button Content="确认每帧处理间隔(整数)" Margin="0,28,0,0" VerticalAlignment="Top" Width="156" Height="32" Click="Button_Click_1"/>
        <TextBox Name="fpsSet" HorizontalAlignment="Left" Margin="156,28,0,0" TextWrapping="Wrap" Text="请输入整数" VerticalAlignment="Top" Width="120" Height="27"/>
        <Button Content="确认权重" Margin="0,60,0,0" VerticalAlignment="Top" Width="156" Height="32" Click="Button_Click_2"/>
        <TextBox Name="setR" HorizontalAlignment="Left" Margin="156,60,0,0" TextWrapping="Wrap" Text="R通道" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="setG" HorizontalAlignment="Left" Margin="276,60,0,0" TextWrapping="Wrap" Text="G通道" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="setB" HorizontalAlignment="Left" Margin="396,60,0,0" TextWrapping="Wrap" Text="B通道" VerticalAlignment="Top" Width="120"/>

    </Grid>
</Window>
