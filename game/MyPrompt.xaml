<Window x:Class="XLOKProject.MyPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XLOKProject"
        mc:Ignorable="d"
        Title="MyPrompt" Height="450" Width="800" Loaded="Window_Loaded"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- 文本区 -->
            <RowDefinition Height="Auto"/>
            <!-- 按钮区 -->
        </Grid.RowDefinitions>
        <!-- 文本显示 -->
        <TextBlock Name="messageText" Grid.Row="0"  
            Text="FuckNet10WPF"
            TextWrapping="Wrap"      
             VerticalAlignment="Center"  
             HorizontalAlignment="Center" />
        <!-- 按钮区 -->
        <StackPanel Name="buttonListUI" Grid.Row="1" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,0,0,4" VerticalAlignment="Bottom" >
            <Button Content="确定" Width="80" Margin="5"/>
            <Button Content="取消" Width="80" Margin="5"/>
            <Button Content="更多" Width="80" Margin="5"/>
        </StackPanel>
        <Button Content="+" Margin="0,0,47,4" VerticalAlignment="Bottom" Width="32" Height="32" HorizontalAlignment="Right" Click="Button_Click"/>
        <Button Content="-" Margin="0,0,10,4" VerticalAlignment="Bottom" Width="32" Height="32" HorizontalAlignment="Right" Click="Button_Click_1"/>
    </Grid>
</Window>
